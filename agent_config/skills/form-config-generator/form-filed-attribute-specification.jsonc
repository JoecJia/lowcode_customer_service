[
  {//单行输入
    "linkInfo": {//数据联动配置
      "linked": false, //是否配置过数据联动
      "linkFormId": 0,  //联动表单id
      "linkFormType": "", //联动类型
      "linkFormIdEnc": "", //联动表单id验证enc
      "linkFormValueFieldId": 0, //联动字段id
      "linkFormValueFieldCompt": "", //联动字段类型名
      "condFields": [] //联动动态条件
    },
    "isShow": true,//显隐规则控制是否显示
    "hasAuthority": true,//右侧配置、角色配置功能、流程配置等控制是否有权限修改值
    "fromDetail": true,//组件是否是子表单内的子组件
    "inDetailGroupIndex": true,//组件在子表单内所在行下标索引 从0开始
    "compt": "editinput",//组件类型名称
    "alias": "1",//组件别名
    "formula": {////单行输入使用 常用公式设置内容
      "status": false, //是否配置公式
      "selIndex": -1,  //选择公式类型项目下标
      "calculateFieldId": "0"//关联"计算"字段id
    },
    "latestValShow": false,//是否开启读取上一次提交的值
    "pid": 0,//父级组件id
    "style": { // 使用说明：此属性不为空则以此字段中配置为准（layoutRatio弃用），为空则layoutRatio依旧有效
      "layout": [ //字段列占比,如：[1,2]，即占整行1/2
        1,
        1
      ],
      "title": { // 标题样式
        "position": "top",
        "align": "left"
      },
      "field": ""  //子表单字段样式，json串
    },
    "id": 1, //组件id
    "fields": [//组件中的字段信息
      {
        "fieldType": { //字段值类型
          "type": "string"
        },
        "label": "单行输入",//组件信息名
        "tip": {//组件标题描述
          "imgs": [], //组件标题描述文件类描述 附件描述
          "text": "" //组件标题文字描述
        },
        "verify": { //字段校验
          "charLimit": { // 是否开启字符长度限制
            "open": false
          },
          "regularExpress": { // 单行输入使用自定义正则表达式
            "errorTip": "格式错误!", //自定义正则匹配失败提示信息
            "express": "" //自定义正则表达式
          },
          "unique": { // 是否开启唯一性检查
            "errMsg": "此项内容已存在，不允许重复提交",
            "open": false
          },
          "required": {},//字段值必填
          "format": {
            "code": {
              "open": false // 是否开启特殊值格式
            },
            "type": "" // 格式类型 邮箱 身份证号等
          }
        },
        "associativeInput": {//联想输入
          "associativeType": "", // 设置的获取联想项方式  '':未设置, bindForm:关联表单字段联想, customOption:自定义联想, api.第三方获取联想
          "customOption": { // 自定义联想项配置
            "options": []
          },
          "api": {  // 第三方获取联想项配置
            "response": [ // 返回值  [{"jpath":"$.result[0].leader"}]
              {
                "jpath": ""
              }
            ],
            "url": [], // 请求url: [{"label":"http://wisdomclass.chaoxing.com/cxoa/sel?username=","type":"text"},{"ftype":"uname","label":"填写人","type":"field","cid":"-1"}]
            "urlHeaders": [] // 请求头 [{"name": "aa","value": "bb"}]
          },
          "bindFormField": { // 关联其他表单字段获取联想项配置
            "bindFormIdEnc": "", //绑定其它表单id验证串
            "bindFieldId": 0, //绑定其它表单字段id
            "bindFieldIdx": 0, //绑定其它表单字段索引下标值
            "bindFormType": "customForm", //绑定类型
            "bindFormId": 0, //绑定其它表单id
            "bindFieldCompt": "" //绑定其它表单字段compt
          }
        },
        "visible": true,//右侧配置字段是否可见
        "desensitive": false,//是否脱敏
        "desensitiveConfig": {// 脱敏规则
          "frontNum": 0,  // 自定义规则：前明文数量
          "lastNum": 0, // 自定义规则：后明文数量
          "ruleType": 0 // 0:默认脱敏，1：自定义规则脱敏
        },
        "editable": true, //字段是否可编辑
        "sweepCode": false, //是否开启扫码录入功能(选人、单行输入)
        "codeChangeable": false, //单行输入设置扫码录入，是否可编辑
        "values": [
          {
            "val": "" //字段值       
          }
        ],
        "hasDefaultValue": false, //是否设置过默认值
        "defaultValueStr": "[{\"val\":\"\"}]",//默认值串
        "inputTip": {  // 单行输入/数字输入 空值提示、前后缀图标
          "prefix": { // 前缀
            "color": "#C0C0C3", // 颜色
            "icon": "" // 图标
          },
          "placeholder": "",  // 空值提示
          "suffix": { // 后缀
            "color": "#C0C0C3",
            "icon": ""
          }
        },
        "cropping": false // 是否开启图片裁切
      }
    ],
    "formulaEdit": { // 公式编辑设置内容
      "formula": "" // 公式
    }
  },
